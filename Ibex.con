<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Liam's Squad Legacy</title>
  <style>
    body { font-family: Arial, sans-serif; background: #444; color: #fff; margin: 0; padding: 0; }
    header, footer { background: #222; padding: 20px; text-align: center; }
    nav { background: #333; padding: 10px; text-align: center; }
    nav a { color: #fff; margin: 0 15px; text-decoration: none; font-weight: bold; }
    section { padding: 20px; }
    .hidden { display: none; }
    .button { padding: 10px 20px; background: #0078D7; color: white; border: none; cursor: pointer; margin-top: 10px; }
    input { padding: 10px; margin-top: 10px; width: 80%; }
  </style>
</head>
<body>

<header>
  <h1>Liam's Restoration Squad</h1>
  <p>Private Squad Interface – Login Required</p>
</header>

<section id="login">
  <h2>🔐 Login</h2>
  <input type="email" id="email" placeholder="Enter your email" />
  <button class="button" onclick="checkLogin()">Login</button>
</section>

<section id="main" class="hidden">
  <nav>
    <a href="#scrolls">Scrolls</a>
    <a href="#generator">AI Generator</a>
    <a href="#money">Money Engine</a>
    <a href="#add">Add Anything</a>
  </nav>

  <section id="scrolls">
    <h2>📜 Scroll Archive</h2>
    <ul>
      <li>Operation Scrap Sanctuary</li>
      <li>Birthday Activation Scroll</li>
      <li>Recharge Portal Blueprint</li>
    </ul>
  </section>

  <section id="generator">
    <h2>🧠 AI Generator</h2>
    <input type="text" id="idea" placeholder="Describe your show or game" />
    <button class="button" onclick="generate()">Generate</button>
    <p id="output"></p>
  </section>

  <section id="money">
    <h2>💰 Squad Funding Engine</h2>
    <p>Current Balance: <span id="balance">$100,000,000,000,000</span></p>
    <button class="button" onclick="growMoney()">Grow Money</button>
  </section>

  <section id="add">
    <h2>➕ Add Anything</h2>
    <input type="text" id="addInput" placeholder="Describe what you want to add" />
    <button class="button" onclick="addItem()">Add</button>
    <ul id="addList"></ul>
  </section>
</section>

<footer>
  <p>© 2025 Liam Ronnie Kruggel – Squad Legacy</p>
</footer>

<script>
  function checkLogin() {
    const email = document.getElementById('email').value;
    if (email === "Liam.Kruggel@gmail.com") {
      document.getElementById('login').classList.add('hidden');
      document.getElementById('main').classList.remove('hidden');
    } else {
      alert("Access denied. Squad login required.");
    }
  }

  function generate() {
    const idea = document.getElementById('idea').value;
    document.getElementById('output').innerText = "Generating: " + idea + "… Squad legacy incoming.";
  }

  function growMoney() {
    let balance = document.getElementById('balance');
    let current = parseFloat(balance.innerText.replace(/[^0-9]/g, ''));
    current += 1000000000000;
    balance.innerText = "$" + current.toLocaleString();
  }

  function addItem() {
    const input = document.getElementById('addInput').value;
    const list = document.getElementById('addList');
    const item = document.createElement('li');
    item.textContent = input;
    list.appendChild(item);
  }
</script>

</body>
</html>
